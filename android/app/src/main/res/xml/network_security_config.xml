<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS everywhere. No exceptions.

    This is the configuration a RELEASE build ships with. There is deliberately
    no cleartext permit of any kind here: a session cookie for a live tenant must
    never be able to travel in the clear, whatever address the app is pointed at.

    The debug build overrides this file with src/debug/res/xml/, which allows
    cleartext to the QA hosts by name so a test build can talk to a local server
    without creating records in a real tenant. Because that permit lives only in
    the debug source set, it cannot reach a release APK even by accident.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
