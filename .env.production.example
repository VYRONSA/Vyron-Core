# Copy to .env.production for local `npm run build` (file is gitignored).
# Active production project: see ACTIVE_SUPABASE.md
# Live Vercel Production MUST use Dashboard → Environment Variables (not this file).

NEXT_PUBLIC_SUPABASE_URL=https://gpiqkwebizuqajgaoxhm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- UMORA public site -----------------------------------------------------
# Canonical/Open Graph URLs are built from this. Without it they fall back to
# https://www.vyroncore.com, which is wrong once UMORA has its own domain.
NEXT_PUBLIC_SITE_URL=https://www.vyroncore.com

# Marketing enquiry delivery (app/api/marketing/enquiry). Set ONE channel.
# Secrets belong in Vercel → Settings → Environment Variables, never in a file.
# Verify with: npm run verify:enquiry   (add -- --send to deliver a test)
#
# 1) CRM / automation webhook:
# UMORA_ENQUIRY_WEBHOOK_URL=https://hooks.example.com/umora-enquiry
# UMORA_ENQUIRY_WEBHOOK_TOKEN=          # bearer token the receiver checks
#
# 2) Or email via Resend:
# RESEND_API_KEY=                        # server-only; never NEXT_PUBLIC_
# UMORA_ENQUIRY_FROM=UMORA Website <website@vyronsoft.co.za>   # verified domain
# UMORA_ENQUIRY_TO=info@vyronsoft.co.za  # optional; defaults to the sales address
