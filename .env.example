# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API.
# Active production project: see ACTIVE_SUPABASE.md
# For local `npm run build`, also copy to .env.production (see .env.production.example).
# Vercel Production: Project → Settings → Environment Variables → Production (build-time; redeploy after change).

NEXT_PUBLIC_SUPABASE_URL=https://ldnrmgafsquzfitcuvxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required for Platform Control → resend client invites (auth.admin.inviteUserByEmail). Server only — never expose in client bundles.
# Use the legacy JWT **service_role** key, or the new dashboard **secret** key as SUPABASE_SECRET_KEY (same Supabase project as the URL).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-server-secret-key
# First-run only: enables POST /api/platform/bootstrap to promote the first Platform Operator
# (see docs/platform-console/first-operator-bootstrap.md). Minimum 32 chars, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset in normal operation — the endpoint is disabled without it. Delete after bootstrap.
# PLATFORM_BOOTSTRAP_SECRET=

# ---------------------------------------------------------------------------
# Platform Console privilege elevation ("Platform Mode") — REQUIRED for /platform.
# ---------------------------------------------------------------------------
# The Platform Supervisor Password is a SECOND factor, separate from the operator's
# login password. Operators sign in normally, then enter it to unlock privileged
# platform actions for a limited window.
#
# Store only the scrypt HASH here — never the password itself. Generate both with:
#   npm run platform:supervisor-secret
#
# Without this, /platform shows "Platform Mode is not configured" and every
# privileged platform API returns 403. It is deliberately fail-closed.
# PLATFORM_SUPERVISOR_SECRET_HASH=scrypt:16384:8:1:<saltBase64>:<hashBase64>
#
# Optional break-glass secondary secret (npm run platform:supervisor-secret -- --emergency).
# Audit logs record which secret was used.
# PLATFORM_SUPERVISOR_SECRET_HASH_EMERGENCY=
#
# Optional tuning (defaults shown).
# PLATFORM_ELEVATION_TTL_MINUTES=30
# PLATFORM_ELEVATION_IDLE_MINUTES=15

# ---------------------------------------------------------------------------
# Deterministic Platform Administrator bootstrap.
# ---------------------------------------------------------------------------
# Declares WHO the platform administrator is. On server start, if the platform has
# ZERO platform operators, this account is created (or repaired) automatically — so a
# fresh install, or an install whose administrator was deleted, heals itself with no
# SQL and no manual Supabase edits. It is a no-op whenever an operator already exists.
#
# See docs/platform-console/platform-admin-provisioning.md
# PLATFORM_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
#
# Only used when the account has to be CREATED. Remove it once the account exists.
#
# ⚠ ALWAYS WRAP THE PASSWORD IN DOUBLE QUOTES. dotenv treats an unquoted '#' as the
#   start of a comment and silently truncates the value, which would provision the
#   account with a shorter, weaker password than you intended. The same applies to
#   '$' (variable expansion) and spaces.
#       PLATFORM_BOOTSTRAP_ADMIN_PASSWORD="S0me#Strong$Password"      correct
#       PLATFORM_BOOTSTRAP_ADMIN_PASSWORD=S0me#Strong$Password        truncated
#   Provisioning verifies a real sign-in afterwards and fails loudly if this happens.
# PLATFORM_BOOTSTRAP_ADMIN_PASSWORD="change-me"

# Company tables / Client Setup require:
# 1. Run sql/000-run-all-companies.sql in the SQL editor (see sql/RUN_COMPANY_TABLES.md).
# 2. Dashboard → Project Settings → API → Exposed schemas must include "public" (comma-separated list, Save).
#    https://supabase.com/dashboard/project/ldnrmgafsquzfitcuvxq/settings/api
