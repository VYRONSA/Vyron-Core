# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API.
# Active production project: see ACTIVE_SUPABASE.md
# For local `npm run build`, also copy to .env.production (see .env.production.example).
# Vercel Production: Project → Settings → Environment Variables → Production (build-time; redeploy after change).

NEXT_PUBLIC_SUPABASE_URL=https://ldnrmgafsquzfitcuvxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required for Platform Control → resend client invites (auth.admin.inviteUserByEmail). Server only — never expose in client bundles.
# Use the legacy JWT **service_role** key, or the new dashboard **secret** key as SUPABASE_SECRET_KEY (same Supabase project as the URL).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=your-server-secret-key
# Company tables / Client Setup require:
# 1. Run sql/000-run-all-companies.sql in the SQL editor (see sql/RUN_COMPANY_TABLES.md).
# 2. Dashboard → Project Settings → API → Exposed schemas must include "public" (comma-separated list, Save).
#    https://supabase.com/dashboard/project/ldnrmgafsquzfitcuvxq/settings/api
